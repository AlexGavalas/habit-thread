# Copy this file to .env.e2e for local Playwright runs.
E2E_DATABASE_URL=postgres://habitthread:habitthread@localhost:5434/habitthread_e2e

PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=habitthread-e2e-only-secret
E2E_REQUEST_DATE=2026-01-12T12:00:00.000Z

# Optional: a unique namespace for one invocation. Omit to generate one.
# Do not reuse across concurrent runs (1-32 lowercase letters/digits/hyphens).
# E2E_RUN_ID=my-isolated-run

# NextAuth requires these when loading the auth module. E2E tests do not use
# the Google provider.
GOOGLE_ID=habitthread-e2e-google-id
GOOGLE_SECRET=habitthread-e2e-google-secret
