# Database (Neon or local Docker Postgres)
DATABASE_URL=postgres://habitthread:habitthread@localhost:5433/habitthread

# E2E database (used only by Playwright)
E2E_DATABASE_URL=postgres://habitthread:habitthread@localhost:5434/habitthread_e2e

# Session secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google login
GOOGLE_ID=
GOOGLE_SECRET=

# Web Push (generate with: mise exec -- pnpm push:generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron authentication
CRON_SECRET=

# AI meal import (server-only; API billing is separate from ChatGPT)
OPENAI_API_KEY=
# Optional; defaults to gpt-4.1-mini
OPENAI_MEAL_IMPORT_MODEL=gpt-4.1-mini
