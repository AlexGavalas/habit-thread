{
    "name": "habitthread",
    "private": true,
    "version": "0.0.1",
    "engines": {
        "node": "24"
    },
    "packageManager": "pnpm@12.3.1",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:analyze": "next analyze",
        "vercel-build": "if [ \"$VERCEL_ENV\" = \"preview\" ] || [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm db:migrate; fi && pnpm build",
        "start": "next start",
        "preview": "pnpm build && pnpm start",
        "push:generate-vapid-keys": "web-push generate-vapid-keys",
        "data:generate-bls": "python3 scripts/generate-bls-index.py BLS_4_0_2025_DE/BLS_4_0_Daten_2025_DE.xlsx src/data/bls-foods.json",
        "test": "TZ=UTC jest",
        "test:a11y": "playwright test --grep @a11y",
        "test:e2e": "playwright test",
        "test:e2e:watch": "playwright test --ui",
        "test:coverage": "TZ=UTC jest --coverage",
        "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --watch",
        "test:watch": "TZ=UTC jest --watch",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:local:up": "docker compose up -d postgres",
        "db:local:down": "docker compose down",
        "db:e2e:up": "docker compose up -d postgres-e2e",
        "db:e2e:down": "docker compose stop postgres-e2e",
        "lint": "oxlint .",
        "check:format": "oxfmt --check .",
        "check:types": "tsc --noEmit",
        "format": "oxfmt",
        "format:all": "pnpm format .",
        "prepare": "husky install",
        "validate": "pnpm lint && pnpm check:format && pnpm check:types"
    },
    "dependencies": {
        "@date-fns/tz": "1.5.0",
        "@flags-sdk/vercel": "1.5.2",
        "@fontsource-variable/noto-sans": "5.3.0",
        "@mantine/carousel": "9.7.3",
        "@mantine/charts": "9.7.3",
        "@mantine/core": "9.7.3",
        "@mantine/dates": "9.7.3",
        "@mantine/form": "9.7.3",
        "@mantine/hooks": "9.7.3",
        "@mantine/modals": "9.7.3",
        "@mantine/notifications": "9.7.3",
        "@tanstack/react-query": "5.104.5",
        "cheerio": "1.2.0",
        "date-fns": "4.4.0",
        "dayjs": "1.11.23",
        "drizzle-orm": "0.45.4",
        "embla-carousel": "8.6.0",
        "embla-carousel-react": "8.6.0",
        "flags": "4.3.1",
        "i18next": "26.5.4",
        "iconoir-react": "7.12.1",
        "jotai": "3.0.1",
        "lodash": "4.18.1",
        "mammoth": "1.13.0",
        "next": "16.4.2",
        "next-auth": "4.24.15",
        "next-i18next": "16.4.1",
        "postgres": "3.4.9",
        "react": "19.3.1",
        "react-dnd": "16.0.1",
        "react-dnd-html5-backend": "16.0.1",
        "react-dom": "19.3.1",
        "react-i18next": "17.1.0",
        "react-to-print": "3.3.0",
        "recharts": "3.10.1",
        "tiny-invariant": "1.3.3",
        "web-push": "3.6.7",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@playwright/test": "1.64.1",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/jest": "30.0.0",
        "@types/jest-axe": "3.5.9",
        "@types/lodash": "4.17.26",
        "@types/node": "24.13.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/web-push": "3.6.4",
        "babel-plugin-react-compiler": "1.0.0",
        "dotenv": "18.0.8",
        "drizzle-kit": "0.31.11",
        "husky": "9.1.7",
        "identity-obj-proxy": "3.0.0",
        "jest": "30.5.2",
        "jest-axe": "11.0.0",
        "jest-environment-jsdom": "30.5.2",
        "lint-staged": "17.6.0",
        "next-router-mock": "1.0.5",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2004",
        "ts-jest": "29.4.15",
        "ts-node": "10.9.2",
        "typescript": "6.0.3"
    }
}
